DASHSCOPE_API_KEY=
# Prefer the public OpenAI-compatible endpoint. Dedicated *.maas.aliyuncs.com hosts
# (e.g. cn-beijing) often time out from Hong Kong / overseas servers.
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-omni-flash
APP_DATA_DIR=var
PORT=3118
# Set this to the public HTTPS origin when deploying behind a reverse proxy.
# APP_ORIGIN=https://example.com
